# Dependency folders (ভারী ফাইল যা আপলোড করার দরকার নেই)
node_modules/
frontend/node_modules/
backend/node_modules/

# Environment files (তোমার গোপন API Key এবং পাসওয়ার্ড)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Database (তোমার লোকাল ডাটাবেস ফাইল যা গিটহাবে পাঠানো ঠিক নয়)
backend/data/*.sqlite
backend/data/*.sqlite-journal

# Next.js build output (অটো-জেনারেটেড ফাইল)
.next/
out/
build/

# OS generated files (অদরকারি সিস্টেম ফাইল)
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

