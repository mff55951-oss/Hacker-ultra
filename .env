# 1. সার্ভার কনফিগারেশন
PORT=5000
NODE_ENV=production

# 2. DeepSeek AI API (তোমার নিজের কী এখানে বসাবে)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 3. ডাটাবেস ফাইল পাথ
DATABASE_URL=./backend/data/nexus_pro.sqlite

# 4. সিকিউরিটি এবং লগইন (JWT)
# এটি একটি শক্তিশালী র্যান্ডম স্ট্রিং হওয়া উচিত
JWT_SECRET=nexus_ultimate_super_secret_key_2026_eyasin

# 5. এডমিন এক্সেস কোড
ADMIN_SECRET_PASS=nexus_admin_secure_99

